# Copy to .env and fill in. Never commit .env.

# ---- Facility ----------------------------------------------------------------
FACILITY_NAME=              # exact public name, used in emails and the CTA (e.g. "A Vibrant Living")
FACILITY_CITY=San Diego
FACILITY_PHONE=             # shown in every post's CTA, e.g. (619) 555-0100
CTA_URL=                    # tour/booking page; defaults to WP_SITE_URL/contact/
CTA_LABEL=Schedule a tour
FAMILY_GUIDE_URL=           # optional downloadable family guide; added to the CTA when set
SERVICES_URL=               # defaults to WP_SITE_URL/services/
CONTACT_URL=                # defaults to WP_SITE_URL/contact/
TIMEZONE=America/Los_Angeles

# ---- WordPress (Users > Profile > Application Passwords) ---------------------
WP_SITE_URL=https://www.avibrantliving.com
WP_USER=
WP_APP_PASSWORD=            # e.g. "abcd efgh ijkl mnop qrst uvwx" (spaces are fine)
WP_POST_STATUS=publish      # set to "draft" to pause live publishing without stopping the schedule
INCLUDE_H1_IN_BODY=false    # most themes print the title as the H1 already; true adds a second H1 in the body

# ---- Writing (Anthropic Claude API) ------------------------------------------
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
ANTHROPIC_EFFORT=high

# ---- Images (Unsplash first, Pexels fallback; one is required, both recommended)
UNSPLASH_ACCESS_KEY=
PEXELS_API_KEY=

# ---- Email notifications (SendGrid, any SMTP mailbox, OR Gmail) ---------------
NOTIFY_EMAIL=vibrantlivingoffice@gmail.com   # comma-separate for several recipients
EMAIL_FROM=info@theseniorlivingexperience.com   # the address emails come from
# Option A: SendGrid (EMAIL_FROM's domain must be authenticated in SendGrid)
SENDGRID_API_KEY=
# Option B: the mailbox's own SMTP server (GoDaddy, Microsoft 365, Zoho, etc.)
SMTP_HOST=                  # e.g. smtpout.secureserver.net, smtp.office365.com, smtp.zoho.com
SMTP_PORT=587               # 465 for SSL
SMTP_USER=                  # usually the full address, info@theseniorlivingexperience.com
SMTP_PASS=
# Option C: Gmail or Google Workspace (Google Account > Security > 2-Step Verification > App passwords)
GMAIL_USER=
GMAIL_APP_PASSWORD=

# ---- Topic queue -------------------------------------------------------------
TOPICS_LOW_WATER_MARK=30
TOPICS_REFILL_COUNT=30
